# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project settings > API). The anon key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by `npm run seed:users`. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
DEMO_USER_PASSWORD=

# Click through the app without Supabase by picking a demo user.
# Ignored when Supabase is configured above, and on Vercel production.
CHORDUS_DEMO_MODE=false

# Only for `npm run test:db`. The public and auth schemas in this database are DROPPED.
DATABASE_URL_TEST=

TZ=Asia/Colombo
